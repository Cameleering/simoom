# Fixed 13-byte reply. HTTP/1.1 and h2c on 8080; HTTP/1.1, HTTP/2 and HTTP/3 with TLS on 8443.
{
    admin off
    auto_https off
    servers :8080 {
        protocols h1 h2c
    }
    servers :8443 {
        protocols h1 h2 h3
    }
}
:8080 {
    header Content-Type text/plain
    respond "Hello, World!" 200
}
https://:8443 {
    tls /opt/bench/cert/cert.pem /opt/bench/cert/key.pem
    header Content-Type text/plain
    respond "Hello, World!" 200
}
