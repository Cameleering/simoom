# Fixed 13-byte reply with `respond` (Caddy's static response handler), S4 bodies from files,
# no admin endpoint, no automatic HTTPS. HTTP/1.1 and h2c on 8080; TLS 1.3 (h1, h2) and HTTP/3
# on 8443 with the bench certificate.
{
	admin off
	auto_https off
	servers :8080 {
		protocols h1 h2c
		timeouts {
			idle 120s
		}
	}
	servers :8443 {
		protocols h1 h2 h3
		timeouts {
			idle 120s
		}
	}
}

(routes) {
	handle /64k {
		root * /opt/bench/files
		file_server
	}
	handle /1m {
		root * /opt/bench/files
		file_server
	}
	handle {
		header Content-Type text/plain
		respond "Hello, World!" 200
	}
}

:8080 {
	import routes
}

https://:8443 {
	tls /opt/bench/cert/cert.pem /opt/bench/cert/key.pem {
		protocols tls1.3
	}
	import routes
}
